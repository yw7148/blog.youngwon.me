# Public content repository configuration
CONTENT_REPOSITORY=yw7148/blog.youngwon.me-content
CONTENT_REF=main

# Optional server-only token for higher GitHub API rate limits
GITHUB_TOKEN=

# Optional analytics token exposed to the browser
PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Server-only Upstash Redis credentials for post metrics and comments
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only secret used to HMAC comment rate-limit identifiers (32+ random bytes recommended)
COMMENT_HMAC_SECRET=
