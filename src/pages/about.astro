---
import BaseLayout from '../layouts/BaseLayout.astro';
import { serializeJsonLd } from '../lib/seo';
import { AUTHOR } from '../lib/site';

const profileJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: AUTHOR.url,
  mainEntity: {
    '@type': 'Person',
    '@id': `${AUTHOR.url}#author`,
    name: AUTHOR.name,
    url: AUTHOR.url,
    description: AUTHOR.description,
    sameAs: [AUTHOR.portfolio, AUTHOR.cv, AUTHOR.github],
  },
};
---

<BaseLayout
  title="소개"
  description={`${AUTHOR.name}의 백엔드 개발 경험과 데이터 일관성·멱등성·운영 안정성에 관한 글쓰기 원칙을 소개합니다.`}
>
  <section class="content-width page-heading">
    <p class="eyebrow">About the author</p>
    <h1>{AUTHOR.name}</h1>
    <p>{AUTHOR.description}</p>
    <p>
      백엔드 서비스를 만들고 운영하며 마주친 문제를 기록합니다.
      당시의 제약, 검토한 선택지, 판단의 근거와 적용 후 남은 한계를 함께 남깁니다.
    </p>
    <nav class="hero-actions" aria-label="작성자 프로필과 연락처">
      <a href={AUTHOR.portfolio}>포트폴리오</a>
      <a href={AUTHOR.cv}>경력기술서</a>
      <a href={AUTHOR.github}>GitHub</a>
      <a href={AUTHOR.email}>이메일</a>
      <a href="/rss.xml">RSS 구독</a>
    </nav>
  </section>

  <section class="content-width about-experience" aria-labelledby="experience-title">
    <h2 id="experience-title">글의 바탕이 된 경험</h2>
    <ul class="check-list">
      <li>Riiid에서 학습 제품의 인증 서버와 게이트웨이를 재개발하고 AI 기능을 백엔드에 연동했습니다.</li>
      <li>CJ 제일제당에서 Computational Biology 플랫폼을 구축·운영하며 Elasticsearch 검색과 Redis 기반 통합 조회를 개선했습니다.</li>
      <li>개인 서비스의 OCI·k3s 인프라와 컨테이너 배포를 운영하며 서비스 경계와 운영 자동화를 다룹니다.</li>
    </ul>
    <p>프로젝트별 역할과 자세한 이력은 <a href={AUTHOR.cv}>경력기술서</a>에 정리했습니다.</p>
  </section>

  <section class="content-width about-grid">
    <div>
      <h2>다루는 주제</h2>
      <ul class="check-list">
        <li>코드와 도메인 모델에 의도를 드러내고 복잡성을 관리하는 방법</li>
        <li>트랜잭션, 비동기 작업, 멱등성처럼 실행 경계와 일관성을 다루는 기준</li>
        <li>오류 전파, API 버전 전환, 호환성처럼 시스템 사이의 계약을 안전하게 바꾸는 방법</li>
        <li>메시지 처리, 실시간 집계, 배포와 성능 회귀처럼 운영 환경에서 드러나는 문제의 추적 과정</li>
      </ul>
    </div>
    <div>
      <h2>글쓰기 원칙</h2>
      <ul class="check-list">
        <li>문제의 맥락과 제약을 먼저 설명하고, 선택지마다 얻는 것과 잃는 것을 비교합니다.</li>
        <li>최종 결정뿐 아니라 처음의 오판, 검증 방법, 적용 후 남은 한계도 숨기지 않습니다.</li>
        <li>회사 내부 이름과 고객 정보는 제거하되, 판단에 필요했던 기술적 맥락은 보존합니다.</li>
        <li>AI 사용 여부보다 검증 가능성을 우선하며, 사실과 경험과 의견을 구분해 씁니다.</li>
        <li>코드 예제에는 실행 환경과 적용 조건을 설명하고, 외부 자료는 공식 문서나 원문을 출처로 연결합니다.</li>
      </ul>
    </div>
  </section>
  <script is:inline type="application/ld+json" set:html={serializeJsonLd(profileJsonLd)} />
</BaseLayout>
