---
import CategoryList from '../components/CategoryList.astro';
import PostList from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllPosts, setContentCacheHeaders } from '../lib/posts';
import { SITE } from '../lib/site';

const posts = await getAllPosts();
const latestPosts = posts.slice(0, 5);
setContentCacheHeaders(Astro.response.headers);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="home-hero content-width">
    <p class="eyebrow">Backend Engineering Notes</p>
    <div class="hero-title-row">
      <h1>Youngwon<br />백엔드 기술 블로그</h1>
      <a class="hero-about-link" href="/about/">
        소개
        <span aria-hidden="true">→</span>
      </a>
    </div>
    <p class="hero-copy">
      무엇이 충족되어야 완료인지, 어떤 조건은 반드시 지켜져야 하는지 먼저 정합니다.<br />
      설계와 구현, 운영에서 그 기준을 어떻게 검증했는지 기록합니다.
    </p>
  </section>

  <section class="content-width section-block" aria-labelledby="latest-posts">
    <div class="section-heading">
      <h2 id="latest-posts">Posts</h2>
      <a class="text-link" href="/posts/">전체 보기</a>
    </div>
    <PostList posts={latestPosts} emptyMessage="아직 공개된 글이 없습니다." />
  </section>

  <section class="content-width section-block" aria-labelledby="categories">
    <div class="section-heading">
      <h2 id="categories">Topics</h2>
    </div>
    <CategoryList categories={SITE.categories} />
  </section>
</BaseLayout>
