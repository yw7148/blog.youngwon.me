---
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, setContentCacheHeaders } from '../../lib/posts';
import { slugifyTag } from '../../lib/tags';

const allPosts = await getAllPosts();
const slug = Astro.params.tag;
const tag = allPosts.flatMap((post) => post.data.tags).find((value) => slugifyTag(value) === slug);

if (!tag) return Astro.rewrite('/404');

const posts = allPosts.filter((post) => post.data.tags.includes(tag));
setContentCacheHeaders(Astro.response.headers);
---

<BaseLayout title={`${tag} 태그`} description={`${tag} 태그가 붙은 글 목록입니다.`}>
  <section class="content-width page-heading">
    <p class="eyebrow">Tag</p>
    <h1>{tag}</h1>
    <p>{posts.length}개의 글이 있습니다.</p>
  </section>

  <section class="content-width section-block" aria-label={`${tag} 태그 글 목록`}>
    <PostList posts={posts} />
  </section>
</BaseLayout>
