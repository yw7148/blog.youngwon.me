---
import { render, type CollectionEntry } from 'astro:content';
import PostEnhancements from '../../components/PostEnhancements.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/format';
import { getAdjacentPosts, getAllPosts, getReadingTime } from '../../lib/posts';
import { SITE } from '../../lib/site';
import { tagHref } from '../../lib/tags';

interface Props {
  post: CollectionEntry<'posts'>;
}

export async function getStaticPaths() {
  const posts = await getAllPosts();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const posts = await getAllPosts();
const { newer, older } = getAdjacentPosts(posts, post.id);
const readingTime = getReadingTime(post.body);
const localCanonical = new URL(`/posts/${post.id}/`, SITE.url).toString();
const canonical = post.data.canonicalUrl ?? localCanonical;
const toc = headings.filter((heading) => heading.depth > 1 && heading.depth <= 3);
const updatedAt = post.data.updatedAt ?? post.data.publishedAt;
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  author: {
    '@type': 'Person',
    name: SITE.author,
  },
  mainEntityOfPage: canonical,
  url: canonical,
  keywords: post.data.tags,
};
---

<BaseLayout title={post.data.title} description={post.data.description} canonical={canonical} type="article">
  <article class="content-width post-shell">
    <header class="post-header">
      <div class="post-card-meta">
        <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
        {
          post.data.updatedAt && (
            <>
              <span aria-hidden="true">·</span>
              <span>수정 {formatDate(post.data.updatedAt)}</span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{readingTime}분</span>
      </div>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <div class="tag-row" aria-label="태그">
        {post.data.tags.map((tag) => <a href={tagHref(tag)}>{tag}</a>)}
      </div>
    </header>

    <div class:list={['post-body-grid', { 'has-toc': toc.length > 0 }]}>
      <div class="post-content">
        <Content />
      </div>

      {
        toc.length > 0 && (
          <aside class="toc" aria-label="목차">
            <strong>목차</strong>
            <ol>
              {toc.map((heading) => (
                <li class={`depth-${heading.depth}`}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }
    </div>

    <nav class="post-navigation" aria-label="이전 글과 다음 글">
      {
        newer ? (
          <a href={`/posts/${newer.id}/`} rel="prev">
            <span>새 글</span>
            {newer.data.title}
          </a>
        ) : (
          <span></span>
        )
      }
      {
        older ? (
          <a href={`/posts/${older.id}/`} rel="next">
            <span>이전 글</span>
            {older.data.title}
          </a>
        ) : (
          <span></span>
        )
      }
    </nav>
  </article>
  <PostEnhancements />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
</BaseLayout>
