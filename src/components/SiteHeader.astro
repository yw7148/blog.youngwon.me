---
const pathname = Astro.url.pathname;

const isBlogHome = pathname === '/';
const isPosts = pathname.startsWith('/posts/') || pathname.startsWith('/tags/');
const isAbout = pathname.startsWith('/about/');
---

<header class="site-header">
  <nav class="site-dock" aria-label="사이트 및 블로그 메뉴">
    <a class="dock-item" href="https://youngwon.me/ko" aria-label="포트폴리오" data-tooltip="Portfolio">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 10.5 12 3l9 7.5" />
        <path d="M5 9.5V21h14V9.5M9 21v-7h6v7" />
      </svg>
    </a>
    <a class="dock-item" href="https://youngwon.me/ko/cv" aria-label="경력기술서" data-tooltip="CV">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 2h9l4 4v16H6z" />
        <path d="M14 2v5h5M9 12h6M9 16h6" />
      </svg>
    </a>
    <a
      class="dock-item"
      href="/"
      aria-label="블로그 홈"
      aria-current={isBlogHome ? 'page' : undefined}
      data-tooltip="Blog"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11v17H6.5A2.5 2.5 0 0 0 4 22z" />
        <path d="M20 5.5A2.5 2.5 0 0 0 17.5 3H13v17h4.5A2.5 2.5 0 0 1 20 22z" />
      </svg>
    </a>

    <span class="dock-separator" aria-hidden="true"></span>

    <a
      class="dock-item"
      href="/posts/"
      aria-label="전체 글"
      aria-current={isPosts ? 'page' : undefined}
      data-tooltip="Posts"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 4h16v16H4zM8 8h8M8 12h8M8 16h5" />
      </svg>
    </a>
    <a
      class="dock-item"
      href="/about/"
      aria-label="블로그 소개"
      aria-current={isAbout ? 'page' : undefined}
      data-tooltip="About"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="8" r="3.5" />
        <path d="M5 21a7 7 0 0 1 14 0" />
      </svg>
    </a>
    <span class="dock-separator" aria-hidden="true"></span>

    <a
      class="dock-item"
      href="https://github.com/yw7148"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub (새 창)"
      data-tooltip="GitHub"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7A5.5 5.5 0 0 0 19.3 3.7 5.1 5.1 0 0 0 19.1 0S18 0 15 1.5a13.4 13.4 0 0 0-7 0C5 0 3.9 0 3.9 0a5.1 5.1 0 0 0-.2 3.7 5.5 5.5 0 0 0-1.5 3.8c0 5.4 3.5 6.6 6.8 7A4.8 4.8 0 0 0 8 18v4" />
        <path d="M8 19c-3 .9-3-1.5-4.2-2" />
      </svg>
    </a>
    <button class="dock-item theme-toggle" type="button" aria-label="테마 전환" data-tooltip="Theme" data-theme-toggle>
      <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
      <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" />
      </svg>
    </button>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  button?.addEventListener('click', () => {
    const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = nextTheme;
    localStorage.setItem('theme', nextTheme);
  });
</script>
