    font-family: var(--font-mono);
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
  }

  .post-content [data-footnote-ref]:is(:hover, [aria-expanded='true']) {
    background: var(--accent);
    color: var(--surface);
  }

  .post-content [data-footnotes] {
    margin-top: 2.5rem;
    border-top: 1px solid var(--border);
    padding-top: 0.75rem;
    font-size: 0.85rem;
  }

  .post-content [data-footnotes] h2 {
    margin-top: 0.75rem;
    font-size: 1rem;
  }

  .post-content [data-footnotes] li {
    scroll-margin-top: 96px;
  }

  .footnote-preview {
    position: fixed;
    z-index: 40;
    width: min(360px, calc(100vw - 24px));
    max-height: min(360px, calc(100dvh - 24px));
    overflow: auto;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow);
    padding: 12px 16px 16px;
    font-size: 0.88rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .footnote-preview[hidden] {
    display: none;
  }

  .footnote-preview-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 6px;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .footnote-preview-header button {
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: 5px;
    background: var(--surface-muted);
    color: var(--text);
    font-size: 1.15rem;
    line-height: 1;
    cursor: pointer;
  }

  .footnote-preview-content > :first-child {
    margin-top: 0;
  }

  .footnote-preview-content > :last-child {
    margin-bottom: 0;
  }

  .footnote-preview-content a {
    color: var(--accent-strong);
  }

  .footnote-preview-content code {
    border-radius: 4px;
    background: var(--surface-muted);
    font-family: var(--font-mono);
    padding: 0.1em 0.25em;
  }
</style>
